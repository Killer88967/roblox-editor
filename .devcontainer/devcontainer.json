{
  "name": "Roblox Editor",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest",
      "ppa": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "pnpmVersion": "latest",
      "nodeGypDependencies": true
    }
  },
  "containerEnv": {
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/roblox_editor",
    "RBXE_PM": "pnpm"
  },
  "forwardPorts": [3000, 8080, 5432],
  "portsAttributes": {
    "3000": { "label": "web" },
    "8080": { "label": "server" },
    "5432": { "label": "postgres", "onAutoForward": "silent" }
  },
  "postCreateCommand": "sudo chown -R $(whoami):$(whoami) /usr/local/cargo &&bash .devcontainer/post-create.sh",
  "postStartCommand": "gh codespace ports visibility 3000:public -c $CODESPACE_NAME || true",
  "hostRequirements": { "cpus": 4 },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "Prisma.prisma",
        "JohnnyMorganz.luau-lsp",
        "RedCMD.json-embedded-languages",
        "yoavbls.pretty-ts-errors",
        "christian-kohler.path-intellisense",
        "ultram4rine.vscode-choosealicense",
        "redhat.vscode-yaml",
        "redhat.vscode-xml"
      ],
      "settings": {
        "workbench.colorTheme": "Dark Modern",
        "workbench.iconTheme": "vscode-modern-icons",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.wordWrap": "on",
        "editor.cursorBlinking": "phase",
        "editor.cursorSmoothCaretAnimation": "on",
        "editor.smoothScrolling": true,
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": "active",
        "editor.guides.bracketPairsHorizontal": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.organizeImports": "explicit"
        },
        "explorer.compactFolders": false,
        "explorer.confirmDelete": false,
        "files.encoding": "utf8",
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true,
        "files.associations": {
          "*.json": "json",
          "devcontainer.json": "jsonc",
          "*.css": "tailwindcss",
          "NOTICE": "markdown"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.scrollback": 10000,
        "git.autofetch": true,
        "eslint.validate": [
          "javascript",
          "javascriptreact",
          "typescript",
          "typescriptreact",
          "mdx"
        ],
        "js/ts.experimental.useTsgo": true,
        "js/ts.tsdk.promptToUseWorkspaceVersion": true,
        "json.schemaDownload.enable": true,
        "license.author": "Killer88967",
        "license.default": "apache-2.0",
        "rust-analyzer.check.command": "clippy",
        "chat.mcp.gallery.enabled": true,
        "chat.mcp.access": "all",
        "chat.mcp.discovery.enabled": {
          "claude-desktop": false,
          "copilot": false,
          "windsurf": false,
          "cursor-global": false,
          "cursor-workspace": false
        },
        "github.copilot.enable": {
          "*": false,
          "plaintext": false,
          "markdown": false,
          "scminput": false
        },
        "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" }
      }
    }
  }
}
