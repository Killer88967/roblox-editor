{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "async": true,
  "console_title_template": "{{ .Folder }}",
  "palette": {
    "bg": "#282C34",
    "muted": "#5C6370",
    "blue": "#61AFEF",
    "green": "#98C379",
    "yellow": "#E5C07B",
    "red": "#E06C75",
    "purple": "#C678DD",
    "cyan": "#56B6C2",
    "orange": "#D19A66"
  },
  "secondary_prompt": {
    "foreground": "p:muted",
    "template": "❯ "
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:blue",
          "template": "<b>{{ .Path }}</b>",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "…",
            "home_icon": "⌂"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if or .Working.Changed .Staging.Changed }}p:yellow{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:cyan{{ end }}"
          ],
          "template": " <p:muted>on</> <b>{{ .HEAD }}</b>{{ if .BranchStatus }} {{ trim .BranchStatus }}{{ end }}{{ if .Staging.Changed }} ✚{{ end }}{{ if .Working.Changed }} ●{{ end }}{{ if gt .StashCount 0 }} ⚑{{ .StashCount }}{{ end }}",
          "options": {
            "branch_icon": "⎇ ",
            "branch_identical_icon": "",
            "branch_ahead_icon": "⇡",
            "branch_behind_icon": "⇣",
            "branch_gone_icon": "⊘",
            "commit_icon": "◎ ",
            "tag_icon": "⌗ ",
            "rebase_icon": "↻ ",
            "cherry_pick_icon": "⊕ ",
            "revert_icon": "↺ ",
            "merge_icon": "⑂ ",
            "no_commits_icon": "∅ "
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:purple",
          "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
          "template": " ❯",
          "options": { "always_enabled": true }
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "p:red",
          "template": "{{ if gt .Code 0 }}✘ {{ .Code }} {{ end }}",
          "options": { "always_enabled": true }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "p:orange",
          "template": "◷ {{ .FormattedMs }} ",
          "options": {
            "threshold": 2000,
            "style": "round"
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:purple",
          "template": "{{ if .Env.RBXE_PM }}⧉ {{ .Env.RBXE_PM }} {{ end }}"
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "p:green",
          "template": "⬢ {{ .Major }}.{{ .Minor }} ",
          "options": { "display_mode": "files" }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:yellow",
          "template": "∿ {{ .Major }}.{{ .Minor }}{{ if .Venv }} ({{ .Venv }}){{ end }} ",
          "options": { "display_mode": "files" }
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:cyan",
          "template": "⊚ {{ .Major }}.{{ .Minor }} ",
          "options": { "display_mode": "files" }
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:orange",
          "template": "⛭ {{ .Major }}.{{ .Minor }} ",
          "options": { "display_mode": "files" }
        }
      ]
    }
  ]
}
