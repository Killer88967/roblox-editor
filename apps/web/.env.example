# Copy to .env.local for local development. On Vercel, set these in Project Settings →
# Environment Variables. Full setup: docs/cloud-setup.md

# Accounts (sign-in, cloud projects, share links) are off unless this is "true". Turn it
# on once the database and storage below are set up. Changing it needs a rebuild/redeploy.
NEXT_PUBLIC_ACCOUNTS_ENABLED=false

# Postgres. The devcontainer already sets this for its built-in database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roblox_editor

# Signs sessions and local storage URLs. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional: your own domain(s), comma-separated (localhost, *.app.github.dev and
# *.vercel.app are always allowed). Or set BETTER_AUTH_URL to one fixed URL instead.
AUTH_ALLOWED_HOSTS=

# Optional sign-in providers (email + password always works).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Cloudflare R2 for saved places and cached assets. Without these, files are stored in
# apps/web/.data (fine for local development, not for Vercel).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Roblox Open Cloud API key with the legacy-asset:manage scope, for decal/texture images.
ROBLOX_API_KEY=
